APP_NAME=WeatherGPT API
APP_ENV=development
DEBUG=false
LOCATION_DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
DATABASE_URL=postgresql+psycopg://weathergpt:weathergpt@localhost:5432/weathergpt
REDIS_URL=redis://localhost:6379/0
# Optional Upstash REST cache. When configured, REDIS_URL remains the fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# OpenWeather is used by the live weather provider.
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=
# These two settings are used only when WEATHER_PROVIDER=external.
WEATHER_API_URL=
WEATHER_API_KEY=
WEATHER_API_TIMEOUT_SECONDS=5
WEATHER_API_RETRIES=2
WEATHER_CACHE_TTL_SECONDS=300
# Use a deployment-specific identifying User-Agent, ideally with a monitored contact channel.
# Do not use a generic HTTP client User-Agent with Nominatim's public service.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=WeatherGPT/1.0 (replace-with-deployment-contact)
NOMINATIM_TIMEOUT_SECONDS=5
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSION=1536
# Calibrate against reviewed retrieval examples; production requires a positive score.
RAG_MINIMUM_SCORE=0
RAG_TRUSTED_PUBLISHERS=[]
# Optional reviewed thresholds JSON; defaults to the bundled configuration.
AGRICULTURAL_THRESHOLDS_PATH=
POSTGRES_DB=weathergpt
POSTGRES_USER=weathergpt
POSTGRES_PASSWORD=weathergpt
VITE_API_BASE_URL=http://localhost:8000/api/v1